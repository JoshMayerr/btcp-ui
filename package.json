{
  "name": "btcp-ui",
  "version": "0.1.0",
  "description": "Reusable BTCP UI kit built with shadcn/ui and Phosphor icons",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run ui:build",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ui:build": "tsx scripts/build-ui-registry.ts",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshMayerr/btcp-ui.git"
  }
}
